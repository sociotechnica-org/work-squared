{
  "name": "@lifebuild/auth-worker",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 0 --persist-to .wrangler/state/auth",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/integration-test.ts",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-all": "pnpm lint:fix && pnpm format && pnpm typecheck"
  },
  "dependencies": {
    "@lifebuild/shared": "workspace:*",
    "@sentry/cloudflare": "^10.54.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "miniflare": "^4.20260526.0",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
