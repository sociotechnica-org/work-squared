{
  "name": "@lifebuild/server",
  "version": "0.1.0",
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npx tsx scripts/integration-test.ts",
    "test:integration:multi-store-startup": "tsx scripts/multi-store-startup-integration-test.ts",
    "test:integration:network-health": "tsx scripts/network-health-integration-test.ts",
    "test:fullstack": "tsx scripts/fullstack-integration-test.ts",
    "test:pi-smoke": "tsx scripts/pi-smoke-test.ts",
    "test:red-green": "npx tsx scripts/red-green-test.ts",
    "test:sync-reconnect": "npx tsx scripts/sync-reconnect-test.ts",
    "clean": "rm -rf data/*",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "lint-all": "pnpm lint:fix && pnpm format && pnpm typecheck"
  },
  "dependencies": {
    "@lifebuild/shared": "workspace:*",
    "@livestore/adapter-node": "catalog:",
    "@livestore/livestore": "catalog:",
    "@livestore/sync-cf": "catalog:",
    "@livestore/utils": "catalog:",
    "@mariozechner/pi-ai": "~0.73.1",
    "@mariozechner/pi-coding-agent": "~0.73.1",
    "@sentry/node": "^10.54.0",
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@sentry/esbuild-plugin": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "esbuild": "^0.28.0",
    "esbuild-node-externals": "^1.22.0",
    "eslint": "catalog:",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
